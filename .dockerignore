# ULTRA-OPTIMIZED .dockerignore - Exclude EVERYTHING not essential
# This reduces build context from ~100MB to ~10MB

# ========================================
# CRITICAL EXCLUSIONS (largest files first)
# ========================================

# Virtual environments (CRITICAL - can be GBs)
venv/
.venv/
env/
ENV/
.env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Git repository (can be large)
.git/
.github/
.gitignore
.gitattributes

# Development tools & IDEs
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Documentation (not needed in production)
*.md
docs/
README*
CHANGELOG*
LICENSE*
*_GUIDE.md
*_README.md
PROJECT_STRUCTURE*

# Test files (not needed in production)
test_*.py
*_test.py
tests/
__tests__/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Build artifacts & distributions
build/
dist/
*.egg-info/
.eggs/
wheels/
*.whl
*.tar.gz

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
.cache/
.pytest_cache/

# Frontend assets (not needed for API)
frontend/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-debug.log*
package*.json
yarn.lock

# Scripts and utilities (not needed in production)
scripts/
tools/
check_docker_size.sh
analyze_dependencies.py
correct_dependency_analysis.py

# Alternative Docker files (only use the main one)
Dockerfile.*
.dockerignore.*
docker-build/
docker-compose*.yml

# Development data samples (keep only essential data)
data/samples/
data/test/
data/backup/
*.sample.xlsx
*.test.csv
trial_balance_data.xlsx

# Jupyter notebooks (development only)
*.ipynb
.ipynb_checkpoints/

# OS and editor files
Thumbs.db
.DS_Store
*.sublime-*
*.tern-port

# Database files (if any - use external DB in production)
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
*~
*.orig

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ========================================
# INCLUDE PATTERNS (what we DO want)
# ========================================
# These are implicitly included unless matched above:
# - src/
# - data/ (essential files only)
# - api.py
# - .env (if exists)
# - requirements.txt